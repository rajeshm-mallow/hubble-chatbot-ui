<nav class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white p-4">
  <div class="container mx-auto flex items-center justify-between">
    <div class="text-2xl font-bold">✨ ChatStudio</div>
    <div>
      <% if user_signed_in? %>
        <span class="mr-4">Hi, <%= current_user.name.presence || current_user.email %></span>
        <%= link_to "New Chat", chats_path, class: "mr-4" %>
        <%= link_to "Logout", destroy_user_session_path, method: :delete, class: "bg-white/10 px-3 py-1 rounded" %>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "mr-4" %>
        <%= link_to "Sign up", new_user_registration_path, class: "bg-white/10 px-3 py-1 rounded" %>
      <% end %>
    </div>
  </div>
</nav>
