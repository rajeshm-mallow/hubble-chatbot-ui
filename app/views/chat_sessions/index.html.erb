<div class="flex flex-col lg:flex-row gap-6">
  <!-- Sidebar: Chat sessions list -->
  <aside class="w-full lg:w-1/4 bg-white shadow rounded-xl p-4">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-gray-800">Your Chats</h2>
      <%= button_to "➕ New Chat", chat_sessions_path, method: :post,
                  class: "text-sm bg-gradient-to-r from-indigo-600 to-purple-600 text-white px-3 py-1 rounded-lg hover:opacity-90 transition" %>
    </div>

    <% if @chat_sessions.any? %>
      <ul class="space-y-2">
        <% @chat_sessions.each do |chat| %>
          <li>
            <%= link_to chat.title,
                        chat_session_path(chat),
                        class: "block px-3 py-2 rounded-lg hover:bg-gray-100 text-gray-700" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-500">No chats yet. Start a new one!</p>
    <% end %>
  </aside>

  <!-- Main panel: Welcome / placeholder -->
  <section class="flex-1 bg-white shadow rounded-xl p-8 text-center flex items-center justify-center">
    <div>
      <h1 class="text-2xl font-bold text-gray-800 mb-2">Welcome to ✨ ChatStudio</h1>
      <p class="text-gray-600 mb-6">Start a conversation and let the AI assist you with your queries.</p>
      <%= link_to "Start a New Chat",
                  chat_sessions_path,
                  method: :post,
                  class: "inline-block bg-gradient-to-r from-indigo-600 to-purple-600 text-white font-semibold px-5 py-2 rounded-lg hover:opacity-90 transition" %>
    </div>
  </section>
</div>
