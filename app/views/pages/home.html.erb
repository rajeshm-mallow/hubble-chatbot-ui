<div class="flex flex-col h-screen bg-gradient-to-br from-slate-50 to-blue-50"
     data-controller="chat"
     data-chat-backend-url-value="<%= ENV.fetch('PYTHON_BACKEND_URL', 'http://localhost:8000') %>"
     data-chat-auth-url-value="<%= auth_path %>"
     data-chat-user-email-value="<%= ENV.fetch('USER_EMAIL', 'default@example.com') %>">
  
  <!-- Header -->
  <div class="bg-white/80 backdrop-blur-sm border-b border-gray-200 shadow-sm sticky top-0 z-10">
    <div class="px-4 sm:px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 bg-gradient-to-r from-blue-600 to-purple-600 rounded-full flex items-center justify-center shadow-lg">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
            </svg>
          </div>
          <div>
            <h1 class="text-lg sm:text-xl font-semibold text-gray-900 gradient-text">Hubble Chatbot</h1>
            <p class="text-xs sm:text-sm text-gray-500">AI Assistant</p>
          </div>
        </div>
        <div class="flex items-center space-x-2">
          <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
          <span class="text-xs sm:text-sm text-gray-500 hidden sm:inline">Online</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Messages Container -->
  <div class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4 messages-container" data-chat-target="messagesContainer">
    <!-- Welcome Message -->
    <div class="flex justify-start mb-6 animate-fade-in">
      <div class="max-w-xs sm:max-w-md lg:max-w-lg">
        <div class="bg-white border border-gray-200 rounded-2xl rounded-bl-md shadow-sm px-4 py-3 message-bubble">
          <div class="text-sm leading-relaxed text-gray-900">
            👋 Hello! I'm your AI assistant. How can I help you today?
          </div>
          <div class="text-xs text-gray-500 mt-2">
            Just now
          </div>
        </div>
      </div>
    </div>
    <!-- Chat messages will be appended here by Stimulus -->
  </div>

  <!-- Input Area -->
  <div class="bg-white/80 backdrop-blur-sm border-t border-gray-200 shadow-lg sticky bottom-0">
    <div class="p-4">
      <!-- Typing Indicator -->
      <div data-chat-target="typingIndicator" class="hidden mb-3">
        <div class="flex items-center space-x-2 text-gray-500">
          <div class="flex space-x-1">
            <div class="w-2 h-2 bg-gray-400 rounded-full typing-dot"></div>
            <div class="w-2 h-2 bg-gray-400 rounded-full typing-dot"></div>
            <div class="w-2 h-2 bg-gray-400 rounded-full typing-dot"></div>
          </div>
          <span class="text-sm">Processing...</span>
        </div>
      </div>

      <!-- Message Input Form -->
      <form data-action="submit->chat#sendMessage" class="flex items-end space-x-3" style="display: flex;justify-content: center;align-items: center;">
        <div class="flex-1 relative" style="display: flex;">
          <textarea
            data-chat-target="messageInput"
            placeholder="Type your message..."
            rows="1"
            class="w-full border border-gray-300 rounded-xl px-4 py-3 pr-12 resize-none focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all duration-200 bg-white/90 backdrop-blur-sm"
            autocomplete="off"
            data-action="input->chat#updateSendButton keydown->chat#handleKeyDown"
            style="min-height: 48px; max-height: 120px;"
          ></textarea>
          <button
            type="button"
            data-action="click->chat#clearInput"
            class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-gray-600 transition-colors duration-200 p-1 rounded-full hover:bg-gray-100"
            title="Clear message"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <button
          type="submit"
          data-chat-target="sendButton"
          class="bg-gradient-to-r from-blue-600 to-purple-600 text-white px-4 sm:px-6 py-3 rounded-xl font-semibold hover:from-blue-700 hover:to-purple-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed transition-all duration-200 transform hover:scale-105 disabled:transform-none btn-hover shadow-lg"
          disabled
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
          </svg>
        </button>
      </form>
      
      <!-- Footer -->
      <div class="mt-3 text-center">
        <p class="text-xs text-gray-400">
          Press <kbd class="px-1 py-0.5 bg-gray-100 rounded text-xs">Enter</kbd> to send, 
          <kbd class="px-1 py-0.5 bg-gray-100 rounded text-xs">Shift + Enter</kbd> for new line
        </p>
      </div>
    </div>
  </div>
</div>
